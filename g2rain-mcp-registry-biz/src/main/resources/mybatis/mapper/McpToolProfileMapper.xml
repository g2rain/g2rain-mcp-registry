    <!-- 技能可见范围：NATIVE、EXTENSION 全局；CUSTOMER 限当前机构；只取启用的 -->
    <sql id="visibleClause">
        (delete_flag = 0 OR delete_flag IS NULL)
        AND status = 'ACTIVE'
        AND (
            resource_type IN ('NATIVE', 'EXTENSION')
            OR (resource_type = 'CUSTOMER' AND organ_id = #{organId, jdbcType=BIGINT})
        )
    </sql>

