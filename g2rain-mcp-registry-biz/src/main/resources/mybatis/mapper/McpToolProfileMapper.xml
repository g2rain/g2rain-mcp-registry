        FROM mcp_tool_profile
        WHERE <include refid="visibleClause"/>
          AND resource_type = #{query.resourceType, jdbcType=VARCHAR}
          <if test="query.serviceId != null">
              AND service_id = #{query.serviceId, jdbcType=BIGINT}
          </if>
          <if test="query.keyword != null and query.keyword != ''">
              AND (name LIKE CONCAT('%', #{query.keyword, jdbcType=VARCHAR}, '%')
                   OR title LIKE CONCAT('%', #{query.keyword, jdbcType=VARCHAR}, '%'))
          </if>
        ORDER BY service_id, name
